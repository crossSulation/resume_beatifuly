# ===== 前端直连模式（浏览器直接调用模型，API Key 会暴露在前端）=====
# 也可以在页面右上角 ⚙️ 设置弹窗中配置
VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_MODEL=gpt-4o-mini

# ===== 内置代理模式（推荐，API Key 保存在服务器端，不暴露给浏览器）=====
# 复制本文件为 .env，填入以下变量，再运行 npm run dev / npm start
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
PORT=8787
