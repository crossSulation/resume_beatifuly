    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
